    "15 minuta pre noćnog autostarta — da stigneš da priključiš auto. Stiže i u tihim satima.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "15 minuta pre noćnog autostarta — da stigneš da priključiš auto. Stiže i u tihim satima."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "15 minutes before the night auto-start — so you have time to plug in the car. It comes through during quiet hours too."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За 15 минут до ночного автостарта — чтобы успеть подключить авто. Приходит и в тихие часы."
          }
        }
      }
    },
