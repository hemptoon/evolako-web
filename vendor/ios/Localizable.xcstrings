    "Aplikacija još nije povezana sa našim sistemom. Da bi zahtev sigurno stigao do nas, pošalji ga i e-mailom.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacija još nije povezana sa našim sistemom. Da bi zahtev sigurno stigao do nas, pošalji ga i e-mailom."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app isn't connected to our system yet. To make sure your request reaches us, send it by email too."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение пока не связано с нашей системой. Чтобы заявка точно дошла до нас, отправь её и по почте."
