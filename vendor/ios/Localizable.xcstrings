        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенесём комплект на новый адрес. Свяжемся в течение 72 ч."
          }
        }
      }
    },
    "Prepiši cene po kWh sa svog EPS računa. Tada su iznosi u aplikaciji tvoji, a ne procena.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
