            "state": "translated",
            "value": "Расход и мощность зарядки подставятся автоматически."
          }
        }
      }
    },
    "Potrošnja je već na tvom računu za struju od EPS-a. Nema šta da se nadoknađuje.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrošnja je već na tvom računu za struju od EPS-a. Nema šta da se nadoknađuje."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The consumption is already on your EPS electricity bill. There's nothing to reimburse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расход уже в твоём счёте EPS за электроэнергию. Возмещать нечего."
          }
        }
      }
    },
    "Potrošnja po danima": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrošnja po danima"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consumption by day"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расход по дням"
          }
        }
      }
    },
    "Potrošnju vidiš na računaru u autu ili u specifikaciji. Iz nje računamo koliko kilometara si napunio. Procenat baterije ne prikazujemo — punjač ga ne vidi.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrošnju vidiš na računaru u autu ili u specifikaciji. Iz nje računamo koliko kilometara si napunio. Procenat baterije ne prikazujemo — punjač ga ne vidi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll find the consumption on the car's trip computer or in its specs. We use it to work out how many kilometers you've charged. We don't show a battery percentage — the charger can't see it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расход видно на бортовом компьютере или в характеристиках авто. По нему считаем, сколько километров ты зарядил. Процент батареи не показываем — зарядка его не видит."
          }
        }
      }
    },
