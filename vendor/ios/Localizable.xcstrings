    "Prenos kompleta na novu adresu uključen je u pretplatu. Proverićemo da li nova garaža može da ga primi i dogovorićemo termin.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenos kompleta na novu adresu uključen je u pretplatu. Proverićemo da li nova garaža može da ga primi i dogovorićemo termin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving the kit to your new address is included in the subscription. We'll check whether the new garage can take it and agree on a date."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенос комплекта на новый адрес входит в подписку. Проверим, подходит ли новый гараж, и договоримся о дате."
          }
        }
      }
    },
    "Prenosimo komplet na novu adresu. Javićemo se u roku od 72 h.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
