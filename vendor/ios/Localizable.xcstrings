    "Bez saglasnosti ne možemo da te kontaktiramo.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez saglasnosti ne možemo da te kontaktiramo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without your consent we can't contact you."
          }
        },
        "ru": {
