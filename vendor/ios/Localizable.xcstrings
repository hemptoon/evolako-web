        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В ночном окне электроэнергия дешевле по низкому тарифу EPS."
          }
        }
      }
    },
    "U poruku dodajemo verziju aplikacije i model telefona — bez toga podršku je teže dati.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "U poruku dodajemo verziju aplikacije i model telefona — bez toga podršku je teže dati."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We add the app version and phone model to the message — support is harder to give without them."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В письмо добавим версию приложения и модель телефона — без них поддержке сложнее помочь."
          }
        }
      }
    },
